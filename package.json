{
  "name": "attendance-system",
  "version": "1.0.0",
  "author": "Mohammed Redha",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "pnpm dev",
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @attendance/api run dev",
    "dev:web": "pnpm --filter @attendance/web run dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @attendance/api run db:generate",
    "db:push": "pnpm --filter @attendance/api run db:push",
    "db:studio": "pnpm --filter @attendance/api run db:studio",
    "db:migrate": "pnpm --filter @attendance/api run db:migrate",
    "db:migrate:deploy": "pnpm --filter @attendance/api run db:migrate:postgres",
    "backup:postgres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup/backup-postgres.ps1",
    "restore:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup/restore-postgres-test.ps1",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate:deploy"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
