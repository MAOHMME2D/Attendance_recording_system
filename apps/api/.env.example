# Prisma CLI reads this file when commands run inside apps/api.
# Copy to apps/api/.env (gitignored). Never commit real credentials.

# PostgreSQL is the runtime database (the schema is prisma/schema.prisma,
# migrations in prisma/migrations). Local bundled server default:
DATABASE_URL="postgresql://attendance_user:CHANGE_ME@localhost:5432/attendance?schema=public"

# Optional maintenance connection (database "postgres"), used by the test
# suites to create/drop throwaway test databases:
DATABASE_ADMIN_URL="postgresql://attendance_admin:CHANGE_ME@localhost:5432/postgres"

# ---- Login protection (defaults shown; override only if needed) ----
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MINUTES=5
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
