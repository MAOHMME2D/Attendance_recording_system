// LEGACY (offline tooling and nothing else): the runtime database is now
// PostgreSQL (see prisma/schema.prisma). This SQLite schema is kept only for
// the retained SQLite export/import tooling, e.g. scripts/apply-sqlite-phase1.ts
// and reading the archived apps/api/prisma/attendance.db.
// Keep in sync with prisma/schema.prisma. See docs/POSTGRES_MIGRATION.md.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client-sqlite"
}

// A single lecture session
model Lecture {
  id                 String   @id @default(uuid())
  name               String            // e.g. "Mathematics - Section A"
  studyPeriod        String   @default("MORNING") // MORNING = صباحي, EVENING = مسائي
  section            String?           // الشعبة المرتبطة بالمحاضرة
  status             String   @default("ACTIVE")  // ACTIVE or CLOSED
  qrToken            String   @unique  // current active QR token
  qrExpiresAt        DateTime          // when the current QR token expires
  createdByUserId    String?
  conductedByUserId  String?
  startedAt          DateTime @default(now())
  closedAt           DateTime?
  createdAt          DateTime @default(now())

  attendances        AttendanceRecord[]
  createdBy          StaffUser? @relation("LectureCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  conductedBy        StaffUser? @relation("LectureConductor", fields: [conductedByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([conductedByUserId])
}

// Pre-registered student in the college database
model Student {
  id           String             @id @default(uuid())
  orderIndex   Int?               // الترتيب من عمود A في الإكسل
  studentCode  String             @unique // الباركود / الرقم التعريفي الفريد ID (عمود G)
  name         String             // اسم الطالب (عمود B)
  studyPeriod  String             @default("MORNING") // MORNING = صباحي, EVENING = مسائي
  section      String?            // الشعبة (عمود C)
  presentCount Int                @default(0) // عدد مرات الحضور (عمود D)
  absentCount  Int                @default(0) // عدد مرات الغياب (عمود E)
  totalSessions Int?              // إجمالي المحاضرات (عمود F)
  rate         Float?             // نسبة الحضور % (اختياري للتوافق القديم)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  attendances  AttendanceRecord[]
  qrTokens     StudentQrToken[]
}

// A student attendance record
model AttendanceRecord {
  id           String    @id @default(uuid())
  lectureId    String
  studentId    String?             // relation to Student (optional)
  studentCode  String?             // student ID / code used to register
  studentName  String              // student's name
  status       String    @default("PRESENT")  // PRESENT, ABSENT
  deviceId     String?             // unique hardware/browser device fingerprint
  ipAddress    String?             // client IP address
  registeredAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  lecture      Lecture   @relation(fields: [lectureId], references: [id])
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([lectureId, studentName])  // prevent duplicate student name in same lecture
}

// Defined college section per study period
model Section {
  id          String   @id @default(uuid())
  studyPeriod String   @default("MORNING") // MORNING or EVENING
  name        String   // "1", "2", "3", "A", etc.
  label       String?  // "الشعبة الأولى", etc.
  createdAt   DateTime @default(now())

  @@unique([studyPeriod, name])
}

// ============================================================
// Phase 1 online foundation: staff authentication, RBAC,
// audit trail, and opaque/revocable student QR credentials.
// ============================================================

model StaffUser {
  id               String    @id @default(uuid())
  staffId          String    @unique
  fullName         String
  role             String    // HEAD_OF_DEPARTMENT | REGISTRAR | LECTURER | TECHNICAL_LECTURER
  passwordHash     String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions          StaffSession[]
  auditLogs         AuditLog[]
  createdLectures   Lecture[]       @relation("LectureCreator")
  conductedLectures Lecture[]       @relation("LectureConductor")
  createdQrTokens   StudentQrToken[]
}

model StaffSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor StaffUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
}

model StudentQrToken {
  id              String    @id @default(uuid())
  studentId       String
  token           String    @unique
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  student  Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([revokedAt])
}

// Key/value store for one-time system markers (for example, the completed
// initial setup). Kept separate from audit logs so it cannot be forged by
// ordinary staff operations.
model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

