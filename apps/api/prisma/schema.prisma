// RUNTIME DATABASE IS POSTGRESQL.
// Migrations live in prisma/migrations/ (0001_init, 0002_online_foundation,
// 0003_staff_management, 0004_phase2_academics).
// See docs/POSTGRES_MIGRATION.md.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lecture {
  id                String   @id @default(uuid())
  name              String
  studyPeriod       String   @default("MORNING")
  section           String?
  courseId          String?
  status            String   @default("ACTIVE")
  qrToken           String   @unique
  qrExpiresAt       DateTime
  createdByUserId   String?
  conductedByUserId String?
  startedAt         DateTime @default(now())
  closedAt          DateTime?
  /// Soft-delete marker: archived lectures keep their attendance records.
  deletedAt         DateTime?
  createdAt         DateTime @default(now())

  attendances AttendanceRecord[]
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy   StaffUser?       @relation("LectureCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  conductedBy StaffUser?       @relation("LectureConductor", fields: [conductedByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([conductedByUserId])
  @@index([courseId])
  @@index([deletedAt])
}

model Student {
  id            String   @id @default(uuid())
  orderIndex    Int?
  studentCode   String   @unique
  name          String
  stage         Int      @default(2)
  studyPeriod   String   @default("MORNING")
  section       String?
  sectionId     String?
  presentCount  Int      @default(0)
  absentCount   Int      @default(0)
  totalSessions Int?
  rate          Float?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances AttendanceRecord[]
  qrTokens    StudentQrToken[]
  sectionRef  Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([stage, sectionId])
  @@index([deletedAt])
}

model AttendanceRecord {
  id           String   @id @default(uuid())
  lectureId    String
  studentId    String?
  studentCode  String?
  studentName  String
  status       String   @default("PRESENT")
  deviceId     String?
  ipAddress    String?
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())

  lecture Lecture  @relation(fields: [lectureId], references: [id])
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Identity is the student row, never the display name: two students may
  // share a name in the same section. Legacy rows with a NULL studentId are
  // allowed because PostgreSQL treats NULLs as distinct in unique indexes.
  @@unique([lectureId, studentId])
  @@index([studentId])
}

model Section {
  id          String   @id @default(uuid())
  stage       Int      @default(2)
  studyPeriod String   @default("MORNING")
  name        String
  label       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students Student[]

  @@unique([stage, studyPeriod, name])
  @@index([stage, studyPeriod])
}

/// Academic subject. A course belongs to one stage; sections are chosen when a
/// lecture is created and lecturers are assigned to the course itself.
model Course {
  id          String   @id @default(uuid())
  code        String
  name        String
  stage       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lectures    Lecture[]
  assignments TeachingAssignment[]

  @@unique([stage, code])
  @@index([stage])
}

/// Grants a lecturer (or technical lecturer) permission to teach a course.
model TeachingAssignment {
  id          String   @id @default(uuid())
  staffUserId String
  courseId    String
  createdAt   DateTime @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, courseId])
  @@index([courseId])
}

model StaffUser {
  id               String    @id @default(uuid())
  staffId          String    @unique
  fullName         String
  role             String
  passwordHash     String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions          StaffSession[]
  auditLogs         AuditLog[]
  createdLectures   Lecture[]       @relation("LectureCreator")
  conductedLectures Lecture[]       @relation("LectureConductor")
  createdQrTokens   StudentQrToken[]
  assignments       TeachingAssignment[]
}

model StaffSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor StaffUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
}

model StudentQrToken {
  id              String    @id @default(uuid())
  studentId       String
  token           String    @unique
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([revokedAt])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
